{
  "name": "zbmui",
  "private": true,
  "scripts": {
    "web": "pnpm --filter=web",
    "ui": "pnpm --filter=@zbmui/ui",
    "cli": "pnpm --filter=@zbmui/cli",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write && prettier --write \"**/*.{md,mdx}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "find . -name node_modules -o -name .next -o -name .turbo -o -name dist -type d -prune | xargs rm -rf",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.7.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24"
  }
}
